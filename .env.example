# ─────────────────────────────────────────────────────────────
# MailStora environment variables (example values only)
# Copy to Server/.env and Client/.env.local and fill in real values.
# Never commit real passwords or keys.
# ─────────────────────────────────────────────────────────────

# ── Server (Server/.env) ──
PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mailstora?retryWrites=true&w=majority
JWT_SECRET=long-random-string-at-least-32-characters
FRONTEND_URL=https://mailstora.com
# Extra allowed origins for CORS, comma separated (optional)
EXTRA_ORIGINS=https://www.mailstora.com
# Optional: Redis cache (the site works without it)
REDIS_URL=
# Admin password used by `npm run seed` to create the first admin login
ADMIN_PASSWORD=
# Email sending (contact form, quotes, booking OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASS=app-password
# Image uploads from the admin (https://api.imgbb.com)
IMGBB_API_KEY=
# One-time code accepted for booking tests. Leave empty in production.
MASTER_OTP=

# ── Client (Client/.env.local, or the hosting dashboard) ──
NEXT_PUBLIC_API_URL=https://api.mailstora.com
# Date the static pages last changed (used in sitemap.xml)
SITE_UPDATED=2026-09-27
